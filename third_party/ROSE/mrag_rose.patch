 from string import upper,join
 
@@ -230,6 +231,67 @@ def mapCollection(stitchedCollection,referenceCollection,bamFileList,mappedFolde
 #=========================MAIN METHOD==============================
 #==================================================================
 
+
+def mapGFFParallel(roseFolder, gffFile, bamFile, mappedOut, nBin, readFloor, readExtension, nThreads):
+    '''
+    Split gffFile into nThreads chunks, run ROSE_bamToGFF.py on each
+    concurrently, then concatenate keeping a single header row.
+    Falls back to the original single background process when nThreads <= 1.
+    '''
+    base = "python %s/ROSE_bamToGFF.py -f %s -e %s -r -m %s -b %s" % (
+        roseFolder, readFloor, readExtension, nBin, bamFile)
+
+    if nThreads <= 1:
+        cmd = "%s -i %s -o %s &" % (base, gffFile, mappedOut)
+        print(cmd)
+        os.system(cmd)
+        return
+
+    lines = open(gffFile).readlines()
+    lines = [l for l in lines if l.strip()]
+    total = len(lines)
+    n = min(nThreads, total) or 1
+    size = (total + n - 1) // n
+
+    chunkDir = mappedOut + '.chunks'
+    if not os.path.isdir(chunkDir):
+        os.makedirs(chunkDir)
+
+    parts = []
+    for i in range(n):
+        piece = lines[i*size:(i+1)*size]
+        if not piece:
+            continue
+        cf = '%s/part_%03d.gff' % (chunkDir, i)
+        fh = open(cf, 'w'); fh.writelines(piece); fh.close()
+        parts.append(cf)
+
+    print('PARALLEL MAPPING: %s regions -> %s chunks' % (total, len(parts)))
+    procs = []
+    for cf in parts:
+        cmd = "%s -i %s -o %s.mapped" % (base, cf, cf)
+        procs.append(subprocess.Popen(cmd, shell=True))
+    for pr in procs:
+        pr.wait()
+
+    out = open(mappedOut, 'w')
+    wroteHeader = False
+    for cf in parts:
+        mf = cf + '.mapped'
+        if not os.path.isfile(mf):
+            print('WARNING: chunk produced no output: %s' % mf)
+            continue
+        fh = open(mf)
+        header = fh.readline()
+        if not wroteHeader:
+            out.write(header); wroteHeader = True
+        for line in fh:
+            out.write(line)
+        fh.close()
+    out.close()
+    print('PARALLEL MAPPING DONE -> %s' % mappedOut)
+
+
 def main():
